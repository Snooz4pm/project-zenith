// =============================================================================
// ZenithScores - Wallet-First Identity System
// =============================================================================
// This is the AUTHORITATIVE schema. No Google Auth, No Email, No NextAuth.
// Identity = Wallet Address. One wallet = One user forever.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// CORE IDENTITY
// =============================================================================

model User {
  id            String    @id @default(cuid())
  walletAddress String    @unique
  username      String?   @unique
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?

  // Relations
  profile       Profile?
  notes         Note[]
  posts         Post[]
  messages      Message[]
  notifications Notification[]
  progresses    CourseProgress[]
  rooms         Room[]            @relation("RoomOwner")
  joinRequests  RoomJoinRequest[]

  @@index([walletAddress])
}

model Profile {
  id       String  @id @default(cuid())
  userId   String  @unique
  bio      String?
  avatar   String?
  isPublic Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// =============================================================================
// LEARNING SYSTEM
// =============================================================================

model Course {
  id          String   @id @default(cuid())
  title       String
  description String?
  slug        String   @unique
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())

  lessons   Lesson[]
  progress  CourseProgress[]
}

model Lesson {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  content   String   @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model CourseProgress {
  id           String   @id @default(cuid())
  userId       String
  courseId     String
  progress     Int      @default(0)  // 0-100
  lastLessonId String?
  updatedAt    DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

// =============================================================================
// NOTES (Personal Memory)
// =============================================================================

model Note {
  id        String   @id @default(cuid())
  userId    String
  content   String   @db.Text
  context   String?  // e.g., "course:solana-basics", "room:traders-lounge"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// =============================================================================
// COMMUNITY - ROOMS
// =============================================================================

model Room {
  id          String   @id @default(cuid())
  title       String
  description String?
  slug        String   @unique
  isPrivate   Boolean  @default(false)
  ownerId     String
  createdAt   DateTime @default(now())

  owner        User              @relation("RoomOwner", fields: [ownerId], references: [id])
  posts        Post[]
  messages     Message[]
  joinRequests RoomJoinRequest[]

  @@index([slug])
  @@index([ownerId])
}

// Private Room Join Requests (ONLY for private rooms)
model RoomJoinRequest {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  status    String   @default("pending") // pending | approved | rejected
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
  @@index([status])
}

// =============================================================================
// COMMUNITY - POSTS & MESSAGES
// =============================================================================

model Post {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
}

model Message {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
}

// =============================================================================
// NOTIFICATIONS
// =============================================================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // join_request | request_approved | new_message | etc.
  payload   Json
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt(sort: Desc)])
}

// =============================================================================
// TRADING ARENA (Non-custodial swap analytics - kept for revenue tracking)
// =============================================================================

model ArenaSwap {
  id               String    @id @default(cuid())
  walletAddress    String
  chainId          Int
  chainName        String?
  sellToken        String
  sellTokenAddress String
  buyToken         String
  buyTokenAddress  String
  sellAmount       String
  buyAmount        String
  sellAmountUSD    Float?
  buyAmountUSD     Float?
  affiliateFee     Float?
  affiliateFeeBps  Int?
  feeToken         String?
  txHash           String    @unique
  txStatus         String    @default("pending")
  blockNumber      Int?
  gasUsed          String?
  gasPrice         String?
  tokenAge         Int?
  liquidityUSD     Float?
  volumeAccel      Float?
  createdAt        DateTime  @default(now())
  confirmedAt      DateTime?

  @@index([walletAddress])
  @@index([chainId])
  @@index([txHash])
  @@index([txStatus])
  @@index([createdAt(sort: Desc)])
}
