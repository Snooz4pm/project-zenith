// =============================================================================
// ZenithScores - Wallet-First Identity System
// =============================================================================
// This is the AUTHORITATIVE schema. No Google Auth, No Email, No NextAuth.
// Identity = Wallet Address. One wallet = One user forever.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// CORE IDENTITY
// =============================================================================

model User {
  id            String    @id @default(cuid())
  walletAddress String    @unique
  username      String?   @unique
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?

  // Relations
  profile       Profile?
  notes         Note[]
  posts         Post[]
  messages      Message[]
  notifications Notification[]
  progresses    CourseProgress[]
  rooms         Room[]            @relation("RoomOwner")
  joinRequests  RoomJoinRequest[]

  @@index([walletAddress])
}

model Profile {
  id       String  @id @default(cuid())
  userId   String  @unique
  bio      String?
  avatar   String?
  isPublic Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// =============================================================================
// LEARNING SYSTEM
// =============================================================================

model Course {
  id          String   @id @default(cuid())
  title       String
  description String?
  slug        String   @unique
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())

  lessons  Lesson[]
  progress CourseProgress[]
}

model Lesson {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  content   String   @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model CourseProgress {
  id           String   @id @default(cuid())
  userId       String
  courseId     String
  progress     Int      @default(0) // 0-100
  lastLessonId String?
  updatedAt    DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

// =============================================================================
// NOTES (Personal Memory)
// =============================================================================

model Note {
  id        String   @id @default(cuid())
  userId    String
  content   String   @db.Text
  context   String? // e.g., "course:solana-basics", "room:traders-lounge"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// =============================================================================
// COMMUNITY - ROOMS
// =============================================================================

model Room {
  id          String   @id @default(cuid())
  title       String
  description String?
  slug        String   @unique
  isPrivate   Boolean  @default(false)
  ownerId     String
  createdAt   DateTime @default(now())

  owner        User              @relation("RoomOwner", fields: [ownerId], references: [id])
  posts        Post[]
  messages     Message[]
  joinRequests RoomJoinRequest[]

  @@index([slug])
  @@index([ownerId])
}

// Private Room Join Requests (ONLY for private rooms)
model RoomJoinRequest {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  status    String   @default("pending") // pending | approved | rejected
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
  @@index([status])
}

// =============================================================================
// COMMUNITY - POSTS & MESSAGES
// =============================================================================

model Post {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
}

model Message {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
}

// =============================================================================
// NOTIFICATIONS
// =============================================================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // join_request | request_approved | new_message | etc.
  payload   Json
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt(sort: Desc)])
}

// =============================================================================
// SWAP RECEIPTS (Non-custodial swap history)
// =============================================================================

model SwapReceipt {
  id             String    @id @default(cuid())
  wallet         String
  inputMint      String
  outputMint     String
  inputSymbol    String?
  outputSymbol   String?
  inAmount       String // Base units
  outAmount      String // Base units
  inAmountUi     Float? // UI amount
  outAmountUi    Float? // UI amount
  inAmountUsd    Float?
  outAmountUsd   Float?
  txid           String    @unique
  routeType      String? // 'best' | 'fastest' | 'low_impact'
  routeHops      Int?
  slippageBps    Int?
  priceImpactPct Float?
  feeAmount      Float? // SOL fee
  status         String    @default("pending") // pending | confirmed | failed
  jitoBundle     Boolean   @default(false)
  jitoBundleId   String?
  errorMessage   String?
  createdAt      DateTime  @default(now())
  confirmedAt    DateTime?

  @@index([wallet])
  @@index([txid])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

// =============================================================================
// TRADING ARENA (Non-custodial swap analytics - kept for revenue tracking)
// =============================================================================

model ArenaSwap {
  id               String    @id @default(cuid())
  walletAddress    String
  chainId          Int
  chainName        String?
  sellToken        String
  sellTokenAddress String
  buyToken         String
  buyTokenAddress  String
  sellAmount       String
  buyAmount        String
  sellAmountUSD    Float?
  buyAmountUSD     Float?
  affiliateFee     Float?
  affiliateFeeBps  Int?
  feeToken         String?
  txHash           String    @unique
  txStatus         String    @default("pending")
  blockNumber      Int?
  gasUsed          String?
  gasPrice         String?
  tokenAge         Int?
  liquidityUSD     Float?
  volumeAccel      Float?
  createdAt        DateTime  @default(now())
  confirmedAt      DateTime?

  @@index([walletAddress])
  @@index([chainId])
  @@index([txHash])
  @@index([txStatus])
  @@index([createdAt(sort: Desc)])
}

// =============================================================================
// PREMIUM SUBSCRIPTIONS (Signed Message + SOL Payment)
// =============================================================================

model PremiumSubscription {
  id            String @id @default(cuid())
  walletAddress String @unique

  // Subscription details
  expiresAt  DateTime
  features   String // JSON: {"walletTracker":true,"newCoins":true,"rugPulls":true}
  amountPaid Float // SOL amount paid

  // Verification
  paymentTxHash String // SOL transfer tx signature
  signedMessage String // User-signed subscription message
  signature     String // Base58 signature

  // Status
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([walletAddress])
  @@index([expiresAt])
  @@index([isActive])
}

// =============================================================================
// PREMIUM ALERTS SYSTEM
// =============================================================================

// User Alert Preferences
model AlertPreferences {
  id            String @id @default(cuid())
  walletAddress String @unique

  // Notification channels
  pushEnabled Boolean @default(true)
  memoEnabled Boolean @default(false)

  // Frequency: instant, daily, weekly
  frequency String @default("instant")

  // Thresholds
  minApeScore      Int   @default(70)
  minTradeSize     Float @default(10000) // USD
  rugRiskThreshold Int   @default(60)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([walletAddress])
}

// Tracked Wallets (Whale Tracking)
model TrackedWallet {
  id             String  @id @default(cuid())
  userWallet     String // Who is tracking
  trackedAddress String // Wallet being tracked
  label          String? // "SOL Whale #1"
  isPreset       Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([userWallet, trackedAddress])
  @@index([userWallet])
}

// User Address Book (Personal Contacts)
model AddressBookEntry {
  id            String  @id @default(cuid())
  userWallet    String  // The owner (wallet address)
  address       String  // The contact's wallet address
  label         String  // "Main Dev", "Raydium Pool", etc.
  category      String? // "Whale", "Exchange", "Deployer", "Custom"
  tags          String[] // ["Safe", "Rugger", "Alpha"]
  notes         String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userWallet, address])
  @@index([userWallet])
}

// Alerts History
model Alert {
  id            String @id @default(cuid())
  walletAddress String // Who receives

  type      String // whale_buy, new_coin, rug_risk
  title     String
  message   String
  tokenMint String?
  metadata  String? // JSON for extra data

  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([walletAddress])
  @@index([createdAt(sort: Desc)])
}

// =============================================================================
// PREDICTIVE MEMORY (Brain Learning System)
// =============================================================================

// Token Learning Data - Directional accuracy tracking
model TokenLearning {
  id     String @id @default(cuid())
  mint   String @unique
  symbol String

  // Directional accuracy (not numeric predictions)
  directionAccuracy       Float @default(0.5) // 0-1, % times got direction right
  magnitudeBucketAccuracy Float @default(0.5) // 0-1, % times got magnitude bucket right
  confidenceScore         Float @default(0.3) // 0-1, trust in learnings

  // Behavior patterns
  typicalHoldMinutes Float? // Observed optimal hold time
  volatilityProfile  String @default("MEDIUM") // LOW | MEDIUM | HIGH

  // Metadata
  learningCount Int      @default(0) // Number of sessions learned from
  lastUpdated   DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@index([mint])
  @@index([directionAccuracy])
  @@index([lastUpdated(sort: Desc)])
}

// Session Comparison - Learning feedback loop
model SessionComparison {
  id          String @id @default(cuid())
  tokenMint   String
  tokenSymbol String

  // Actual outcome
  actualDirection     String // UP | DOWN | FLAT
  actualBucket        Int // 0: <2%, 1: 2-5%, 2: >5%
  actualPercentChange Float // For analytics

  // Predicted (what brain suggested)
  predictedDirection String // UP | DOWN | FLAT
  predictedBucket    Int // 0-2

  // Context
  timeBetweenSessions Int // minutes
  marketRegime        String // BULL | BEAR | SIDEWAYS | VOLATILE

  // Outcome
  wasDirectionCorrect Boolean
  wasBucketCorrect    Boolean

  createdAt DateTime @default(now())

  @@index([tokenMint])
  @@index([createdAt(sort: Desc)])
  @@index([wasDirectionCorrect])
}

// =============================================================================
// SMART SWAP EXECUTION (Brain-Guided Mission Control)
// =============================================================================

model SmartSwap {
  id     String @id @default(uuid())
  userId String // Wallet Address or User ID

  status      String // PLANNED | IN_PROGRESS | ABORTED | COMPLETED
  abortReason String?

  fromToken      String
  toToken        String
  startValueSOL  Float
  targetValueSOL Float?

  currentStepIndex Int    @default(0)
  scenario         String @default("BALANCED")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  abortedAt DateTime?

  steps SmartSwapStep[]

  @@index([userId])
  @@index([status])
}

model SmartSwapStep {
  id     String @id @default(uuid())
  swapId String
  index  Int

  action String // SWAP | HOLD
  status String
  // PLANNED | QUOTE_READY | SIGNED | CONFIRMED | ABORTED | WAITING (for HOLD)

  fromToken String
  toToken   String

  expectedValueSOL    Float
  minValueSOL         Float // Timeout Logic
  quoteFetchedAt      DateTime?
  quoteExpiresAt      DateTime?
  quoteFreshnessMaxMs Int? // Scenario specific tolerance

  // Deviation Protection
  expectedOutAmount      String? // Base units from initial quote
  maxAllowedDeviationPct Float? // e.g. 0.8% - 5.0%

  // HOLD-specific fields
  holdMinutes Int? // For HOLD actions
  holdUntil   DateTime? // Calculated deadline for HOLD
  holdReason  String? // Why we're holding

  // Outcome
  txSignature String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  swap SmartSwap @relation(fields: [swapId], references: [id])

  @@index([swapId])
  @@index([status])
}

// =============================================================================
// PREDICTION TESTING (Brain Validation)
// =============================================================================

model PredictionTest {
  id              String @id @default(uuid())
  totalTokens     Int
  durationMinutes Int
  cyclesCompleted Int    @default(0)
  accuracy        Float? // % of correct predictions
  status          String // RUNNING | COMPLETED | FAILED

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  cycles PredictionCycle[]

  @@index([status])
}

model PredictionCycle {
  id     String @id @default(uuid())
  testId String
  cycle  Int // Which minute (0-9 for 10min test)

  token          String
  symbol         String
  startPrice     Float
  endPrice       Float
  priceChangePct Float

  predicted  String // UP | DOWN | NEUTRAL
  actual     String // UP | DOWN | NEUTRAL
  correct    Boolean
  confidence Float

  createdAt DateTime @default(now())

  test PredictionTest @relation(fields: [testId], references: [id])

  @@index([testId])
  @@index([correct])
}

// =============================================================================
// PAPER TRADING (Full Brain Simulation)
// =============================================================================

model PaperTrade {
  id String @id @default(uuid())

  startCapitalUSD Float // e.g., 100
  currentValueUSD Float // Live portfolio value
  finalValueUSD   Float? // End value
  roiPct          Float? // (final - start) / start * 100

  durationMinutes Int // e.g., 30
  status          String // RUNNING | COMPLETED | FAILED

  // Current holdings
  currentToken  String? // What token we're holding now
  currentAmount Float? // How much

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  decisions PaperTradeDecision[]

  @@index([status])
}

model PaperTradeDecision {
  id      String @id @default(uuid())
  tradeId String
  index   Int

  action String // SWAP | HOLD | EXIT

  // For SWAP
  fromToken   String?
  toToken     String?
  fromAmount  Float?
  expectedOut Float? // Brain's prediction
  actualOut   Float? // Jupiter quote result
  accuracyPct Float? // |expected - actual| / expected * 100

  // For HOLD
  holdMinutes    Int?
  holdReason     String?
  priceAtStart   Float?
  priceAtEnd     Float?
  priceChangePct Float?

  // Outcome
  portfolioValueUSD Float? // Portfolio value after this decision

  timestamp DateTime @default(now())

  trade PaperTrade @relation(fields: [tradeId], references: [id])

  @@index([tradeId])
}

// =============================================================================
// LEARNING VALIDATION (8-Pillar Self-Deception Prevention)
// =============================================================================
// Minimal schema for immutable learning run persistence.
// UI only READS from these tables - no edits, no overrides.
// =============================================================================

model LearningRun {
  id               String    @id @default(uuid())
  startedAt        DateTime  @default(now())
  endedAt          DateTime?
  finalVerdict     String    // EDGE_VALIDATED | NO_EDGE_BASELINE_BEATS_BRAIN | NO_TRADE_LOW_OPPORTUNITY | LEARNING_SATURATED_EARLY
  executionAllowed Boolean   @default(false)
  config           Json?     // maxCycles, tokensPerCycle, narrowingRatio
  
  cycles           LearningCycle[]
  decisions        LearningTokenDecision[]

  @@index([startedAt(sort: Desc)])
  @@index([finalVerdict])
}

model LearningCycle {
  id               String  @id @default(uuid())
  runId            String
  cycleIndex       Int
  regime           String  // TREND_UP | TREND_DOWN | RANGE | CHAOS
  regimeConfidence Float
  accuracy         Float
  baselineRandom   Float
  baselineMomentum Float
  opportunityScore Float
  saturationHit    Boolean
  decision         String  // CONTINUE | STOP_SATURATION | STOP_NO_EDGE | STOP_NO_OPPORTUNITY
  tokensBefore     Int
  tokensAfter      Int
  
  run              LearningRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([cycleIndex])
}

model LearningTokenDecision {
  id         String   @id @default(uuid())
  runId      String
  cycleIndex Int
  token      String
  mint       String
  prediction String   // UP | DOWN | FLAT
  actual     String   // UP | DOWN | FLAT
  scoreDelta Float
  reasons    String[] // Top 2 contributing reasons
  eliminated Boolean  @default(false)
  
  run        LearningRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([cycleIndex])
  @@index([token])
}

// =============================================================================
// TRUST / AUTHORITY COMPOUNDING (Pillar 9)
// =============================================================================
// Permission governance based on accumulated discipline.
// Does NOT affect predictions. Does NOT override learning verdicts.
// =============================================================================

model TrustState {
  id          String   @id @default("current")
  trustLevel  Int      @default(0) // 0-4
  updatedAt   DateTime @updatedAt
}

model TrustHistory {
  id        String   @id @default(uuid())
  fromLevel Int
  toLevel   Int
  reason    String
  timestamp DateTime @default(now())

  @@index([timestamp(sort: Desc)])
}

model TrustViolation {
  id          String   @id @default(uuid())
  type        String   // EXECUTED_WITHOUT_EDGE, EXCEEDED_TRADE_LIMIT, etc.
  description String
  severity    String   // LOW, MEDIUM, HIGH, CRITICAL
  timestamp   DateTime @default(now())

  @@index([timestamp(sort: Desc)])
  @@index([severity])
}

// =============================================================================
// ENGINE MEMORY DB (5-Phase Capital Lifecycle)
// =============================================================================
// Layer 2 — Capital Brain. Persistent truth for portfolio and lifecycle.
// Invariant: free_capital + allocated_capital = total_equity
// =============================================================================

model EnginePortfolio {
  id               String   @id @default("main")
  baseAsset        String   @default("SOL") // SOL or USDC
  initialCapital   Float
  freeCapital      Float
  allocatedCapital Float
  realizedPnl      Float    @default(0)
  unrealizedPnl    Float    @default(0)
  maxRiskPct       Float    @default(15) // Max single position %
  mode             String   @default("sim") // sim | live
  updatedAt        DateTime @updatedAt

  @@index([mode])
}

model EngineOpportunity {
  id                String   @id @default(uuid())
  mint              String   @unique
  symbol            String
  phase             String   @default("OBSERVING") // OBSERVING | SEEDING | SCALING | HARVESTING | RECYCLE
  
  // Reputation (OBSERVING)
  shadowPnl         Float    @default(0)
  fakeoutCount      Int      @default(0)
  signalMatchScore  Float    @default(0)
  blacklisted       Boolean  @default(false)
  
  // Seeding
  seedEntryPrice    Float?
  probingSlippage   Float?
  probingAllocationPct Float @default(15)
  
  // Scaling
  fullAllocationPct Float?
  maxAdverseExcursion Float?
  
  // Harvesting
  harvestThreshold  Float?
  moonbagSize       Float?
  
  // Recycle
  cooldownUntil     DateTime?
  yieldToReinvest   Float?
  
  // Metadata
  detectedAt        DateTime @default(now())
  lastTransitionAt  DateTime @updatedAt
  
  positions         EnginePosition[]
  capitalMovements  CapitalMovement[]

  @@index([phase])
  @@index([blacklisted])
  @@index([mint])
}

model EnginePosition {
  id              String   @id @default(uuid())
  mint            String
  symbol          String
  size            Float
  entryPrice      Float
  currentPrice    Float
  unrealizedPnl   Float    @default(0)
  phase           String   // Mirrors opportunity phase
  openedAt        DateTime @default(now())
  
  opportunityId   String?
  opportunity     EngineOpportunity? @relation(fields: [opportunityId], references: [id])

  @@index([mint])
  @@index([phase])
}

model CapitalMovement {
  id              String   @id @default(uuid())
  type            String   // seed | scale | harvest | recycle | fee | loss | profit
  amount          Float
  fromBucket      String   // free | allocated | external
  toBucket        String   // free | allocated | external
  reason          String?
  
  opportunityId   String?
  opportunity     EngineOpportunity? @relation(fields: [opportunityId], references: [id])
  
  timestamp       DateTime @default(now())

  @@index([type])
  @@index([timestamp(sort: Desc)])
}

// =============================================================================
// TOKEN BLACKLIST (Rug Fingerprinting - Persists across restarts)
// =============================================================================

model TokenBlacklist {
  id          String   @id @default(uuid())
  mint        String   @unique
  symbol      String?
  reason      String   // rug_detected | fake_liquidity | manual
  fingerprint Json?    // { volume, depth, concentration } at time of rug
  detectedAt  DateTime @default(now())

  @@index([mint])
}
