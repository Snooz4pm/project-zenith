// =============================================================================
// ZenithScores - Wallet-First Identity System
// =============================================================================
// This is the AUTHORITATIVE schema. No Google Auth, No Email, No NextAuth.
// Identity = Wallet Address. One wallet = One user forever.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// CORE IDENTITY
// =============================================================================

model User {
  id            String    @id @default(cuid())
  walletAddress String    @unique
  username      String?   @unique
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?

  // Relations
  profile       Profile?
  notes         Note[]
  posts         Post[]
  messages      Message[]
  notifications Notification[]
  progresses    CourseProgress[]
  rooms         Room[]            @relation("RoomOwner")
  joinRequests  RoomJoinRequest[]

  @@index([walletAddress])
}

model Profile {
  id       String  @id @default(cuid())
  userId   String  @unique
  bio      String?
  avatar   String?
  isPublic Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// =============================================================================
// LEARNING SYSTEM
// =============================================================================

model Course {
  id          String   @id @default(cuid())
  title       String
  description String?
  slug        String   @unique
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())

  lessons   Lesson[]
  progress  CourseProgress[]
}

model Lesson {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  content   String   @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model CourseProgress {
  id           String   @id @default(cuid())
  userId       String
  courseId     String
  progress     Int      @default(0)  // 0-100
  lastLessonId String?
  updatedAt    DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

// =============================================================================
// NOTES (Personal Memory)
// =============================================================================

model Note {
  id        String   @id @default(cuid())
  userId    String
  content   String   @db.Text
  context   String?  // e.g., "course:solana-basics", "room:traders-lounge"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// =============================================================================
// COMMUNITY - ROOMS
// =============================================================================

model Room {
  id          String   @id @default(cuid())
  title       String
  description String?
  slug        String   @unique
  isPrivate   Boolean  @default(false)
  ownerId     String
  createdAt   DateTime @default(now())

  owner        User              @relation("RoomOwner", fields: [ownerId], references: [id])
  posts        Post[]
  messages     Message[]
  joinRequests RoomJoinRequest[]

  @@index([slug])
  @@index([ownerId])
}

// Private Room Join Requests (ONLY for private rooms)
model RoomJoinRequest {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  status    String   @default("pending") // pending | approved | rejected
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
  @@index([status])
}

// =============================================================================
// COMMUNITY - POSTS & MESSAGES
// =============================================================================

model Post {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
}

model Message {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
}

// =============================================================================
// NOTIFICATIONS
// =============================================================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // join_request | request_approved | new_message | etc.
  payload   Json
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt(sort: Desc)])
}

// =============================================================================
// SWAP RECEIPTS (Non-custodial swap history)
// =============================================================================

model SwapReceipt {
  id               String    @id @default(cuid())
  wallet           String
  inputMint        String
  outputMint       String
  inputSymbol      String?
  outputSymbol     String?
  inAmount         String    // Base units
  outAmount        String    // Base units
  inAmountUi       Float?    // UI amount
  outAmountUi      Float?    // UI amount
  inAmountUsd      Float?
  outAmountUsd     Float?
  txid             String    @unique
  routeType        String?   // 'best' | 'fastest' | 'low_impact'
  routeHops        Int?
  slippageBps      Int?
  priceImpactPct   Float?
  feeAmount        Float?    // SOL fee
  status           String    @default("pending") // pending | confirmed | failed
  jitoBundle       Boolean   @default(false)
  jitoBundleId     String?
  errorMessage     String?
  createdAt        DateTime  @default(now())
  confirmedAt      DateTime?

  @@index([wallet])
  @@index([txid])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

// =============================================================================
// TRADING ARENA (Non-custodial swap analytics - kept for revenue tracking)
// =============================================================================

model ArenaSwap {
  id               String    @id @default(cuid())
  walletAddress    String
  chainId          Int
  chainName        String?
  sellToken        String
  sellTokenAddress String
  buyToken         String
  buyTokenAddress  String
  sellAmount       String
  buyAmount        String
  sellAmountUSD    Float?
  buyAmountUSD     Float?
  affiliateFee     Float?
  affiliateFeeBps  Int?
  feeToken         String?
  txHash           String    @unique
  txStatus         String    @default("pending")
  blockNumber      Int?
  gasUsed          String?
  gasPrice         String?
  tokenAge         Int?
  liquidityUSD     Float?
  volumeAccel      Float?
  createdAt        DateTime  @default(now())
  confirmedAt      DateTime?

  @@index([walletAddress])
  @@index([chainId])
  @@index([txHash])
  @@index([txStatus])
  @@index([createdAt(sort: Desc)])
}

// =============================================================================
// PREMIUM SUBSCRIPTIONS (Signed Message + SOL Payment)
// =============================================================================

model PremiumSubscription {
  id              String   @id @default(cuid())
  walletAddress   String   @unique
  
  // Subscription details
  expiresAt       DateTime
  features        String   // JSON: {"walletTracker":true,"newCoins":true,"rugPulls":true}
  amountPaid      Float    // SOL amount paid
  
  // Verification
  paymentTxHash   String   // SOL transfer tx signature
  signedMessage   String   // User-signed subscription message
  signature       String   // Base58 signature
  
  // Status
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([walletAddress])
  @@index([expiresAt])
  @@index([isActive])
}

// =============================================================================
// PREMIUM ALERTS SYSTEM
// =============================================================================

// User Alert Preferences
model AlertPreferences {
  id              String   @id @default(cuid())
  walletAddress   String   @unique
  
  // Notification channels
  pushEnabled     Boolean  @default(true)
  memoEnabled     Boolean  @default(false)
  
  // Frequency: instant, daily, weekly
  frequency       String   @default("instant")
  
  // Thresholds
  minApeScore     Int      @default(70)
  minTradeSize    Float    @default(10000) // USD
  rugRiskThreshold Int     @default(60)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([walletAddress])
}

// Tracked Wallets (Whale Tracking)
model TrackedWallet {
  id              String   @id @default(cuid())
  userWallet      String   // Who is tracking
  trackedAddress  String   // Wallet being tracked
  label           String?  // "SOL Whale #1"
  isPreset        Boolean  @default(false)
  
  createdAt       DateTime @default(now())
  
  @@unique([userWallet, trackedAddress])
  @@index([userWallet])
}

// Alerts History
model Alert {
  id              String   @id @default(cuid())
  walletAddress   String   // Who receives
  
  type            String   // whale_buy, new_coin, rug_risk
  title           String
  message         String
  tokenMint       String?
  metadata        String?  // JSON for extra data
  
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())
  
  @@index([walletAddress])
  @@index([createdAt(sort: Desc)])
}

// =============================================================================
// PREDICTIVE MEMORY (Brain Learning System)
// =============================================================================

// Token Learning Data - Directional accuracy tracking
model TokenLearning {
  id                      String   @id @default(cuid())
  mint                    String   @unique
  symbol                  String
  
  // Directional accuracy (not numeric predictions)
  directionAccuracy       Float    @default(0.5)  // 0-1, % times got direction right
  magnitudeBucketAccuracy Float    @default(0.5)  // 0-1, % times got magnitude bucket right
  confidenceScore         Float    @default(0.3)  // 0-1, trust in learnings
  
  // Behavior patterns
  typicalHoldMinutes      Float?   // Observed optimal hold time
  volatilityProfile       String   @default("MEDIUM") // LOW | MEDIUM | HIGH
  
  // Metadata
  learningCount           Int      @default(0)  // Number of sessions learned from
  lastUpdated             DateTime @updatedAt
  createdAt               DateTime @default(now())
  
  @@index([mint])
  @@index([directionAccuracy])
  @@index([lastUpdated(sort: Desc)])
}

// Session Comparison - Learning feedback loop
model SessionComparison {
  id                   String   @id @default(cuid())
  tokenMint            String
  tokenSymbol          String
  
  // Actual outcome
  actualDirection      String   // UP | DOWN | FLAT
  actualBucket         Int      // 0: <2%, 1: 2-5%, 2: >5%
  actualPercentChange  Float    // For analytics
  
  // Predicted (what brain suggested)
  predictedDirection   String   // UP | DOWN | FLAT
  predictedBucket      Int      // 0-2
  
  // Context
  timeBetweenSessions  Int      // minutes
  marketRegime         String   // BULL | BEAR | SIDEWAYS | VOLATILE
  
  // Outcome
  wasDirectionCorrect  Boolean
  wasBucketCorrect     Boolean
  
  createdAt            DateTime @default(now())
  
  @@index([tokenMint])
  @@index([createdAt(sort: Desc)])
  @@index([wasDirectionCorrect])
}

